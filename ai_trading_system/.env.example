# Copy this file to .env and fill in your own values. Never commit .env.
#
# Binance Futures Testnet keys: https://testnet.binancefuture.com
# Binance Futures live keys:    https://www.binance.com/en/my/settings/api-management
#   - Enable "Reading" and "Enable Futures" only.
#   - Do NOT enable "Enable Withdrawals" on a bot key.

BINANCE_API_KEY=
BINANCE_API_SECRET=

# "testnet" (paper trading against Binance's real testnet), "dry_run"
# (simulated fills against live market data, no exchange orders at all),
# or "live" (real orders, real funds).
TRADING_MODE=dry_run

# Extra safety gate: live order placement is refused unless this is set
# to exactly "I_UNDERSTAND_THE_RISK", even if TRADING_MODE=live.
LIVE_TRADING_CONFIRMATION=
