# KIS Developers (한국투자증권) API 인증정보
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=           # 계좌번호 앞 8자리
KIS_ACCOUNT_PRODUCT_CD=01 # 계좌번호 뒤 2자리 상품코드
KIS_MODE=paper            # paper(모의투자) 또는 real(실전투자)
KIS_REQUEST_INTERVAL_SEC=1.05  # TR별 초당 호출 제한(EGW00201) 방지용 최소 요청 간격(초)

# 실전투자(real) 주문을 실제로 전송하려면 아래를 명시적으로 yes 로 설정해야 함
CONFIRM_REAL_TRADING=no

# 매매 대상 종목 (콤마 구분), 거래소 코드 (NAS/NYS/AMS 등)
WATCHLIST=AAPL,MSFT,NVDA
EXCHANGE=NAS

# 포지션 점검 주기(초)
POLL_INTERVAL_SEC=300

# 리스크 관리
RISK_TAKE_PROFIT_PCT=0.05
RISK_STOP_LOSS_PCT=-0.05
RISK_MAX_POSITION_PCT=0.2
RISK_MAX_OPEN_POSITIONS=5

# 전략 파라미터 (백테스트로 튜닝 권장, 미설정시 기본값 사용)
# STRAT_MA_SHORT=112
# STRAT_MA_MID=224
# STRAT_MA_LONG=448
# STRAT_ACC_LOOKBACK=60
# STRAT_ACC_VOL_MULT=2.0
# STRAT_ACC_WICK_RATIO=0.3
# STRAT_BASE_MIN_DAYS=5
# STRAT_BASE_MAX_DAYS=20
# STRAT_BASE_TOLERANCE=0.03
# STRAT_BB_WINDOW=20
# STRAT_BB_STD=2.0
# STRAT_BB_SQUEEZE_LOOKBACK=60
# STRAT_BB_SQUEEZE_PCTL=0.25
# STRAT_MA_SHORT_PROXIMITY=0.03
# STRAT_MIN_REVERSE_DAYS=20

STATE_FILE=trading_bot_state.json
